{
  "name": "semantic-qa",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "main": "src/server.js",
  "scripts": {
    "dev": "node ../src/runPackageBin.js concurrently --kill-others=false \"node src/server.js\" \"node ../src/runPackageBin.js vite --config vite.config.js\"",
    "start": "node src/server.js",
    "import:universal": "node scripts/importUniversalQa.js",
    "import:universal:check": "node scripts/importUniversalQa.js --check",
    "preflight:universal:v5": "node scripts/preflightUniversalV5.js",
    "rebuild:universal:v5": "node scripts/rebuildUniversalV5.js",
    "sync:universal:v5": "node scripts/rebuildUniversalV5.js --incremental",
    "eval:universal": "node scripts/evaluateRetrieval.js",
    "eval:corpus": "node scripts/evaluateCorpusQueries.js",
    "eval:promotion:v5": "node scripts/evaluateV5Promotion.js",
    "validate:v5-db": "node scripts/validateV5Database.js",
    "test": "node --test test/",
    "build": "node ../src/runPackageBin.js vite build --config vite.config.js",
    "preview": "node ../src/runPackageBin.js vite preview --config vite.config.js --port 5176",
    "health": "node -e \"fetch('http://localhost:8790/api/health').then(r=>r.text()).then(t=>console.log(t)).catch(e=>{console.error(e.message); process.exit(1);})\""
  },
  "dependencies": {
    "express": "^5.2.1",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "concurrently": "^9.2.1",
    "vite": "^7.3.1"
  }
}
